# =============================================================================
# SAHOO SWEETS - BACKEND ENVIRONMENT VARIABLES
# =============================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Admin Master Access PIN (Required when Role = 'admin')
ADMIN_ACCESS_PIN=9900

# Secret Key for JWT Session Tokens
JWT_SECRET=sahoo_sweets_super_secret_jwt_key_2026

# -----------------------------------------------------------------------------
# 1. EMAIL DELIVERY (Nodemailer SMTP or Resend API)
# -----------------------------------------------------------------------------
# Option A: Nodemailer SMTP (e.g. Gmail App Password)
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Sahoo Sweets" <your_email@gmail.com>

# Option B: Resend API (Alternative to SMTP)
RESEND_API_KEY=re_1234567890abcdef
RESEND_FROM=onboarding@resend.dev

# -----------------------------------------------------------------------------
# 2. INDIAN SMS DELIVERY (Fast2SMS or MSG91)
# -----------------------------------------------------------------------------
# Fast2SMS API Key (https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
SMS_API_KEY=your_fast2sms_api_key_here

# MSG91 Credentials (Optional Alternative)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_otp_template_id
