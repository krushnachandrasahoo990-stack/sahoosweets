# =============================================================================
# SAHOO SWEETS - PRODUCTION & LOCAL BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Frontend Allowed URL for CORS (Set this to your live Vercel URL on Render)
# Example: FRONTEND_URL=https://sahoosweets.vercel.app
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection URI
# Example: MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sahoosweets?retryWrites=true&w=majority
MONGODB_URI=

# Admin Master Access PIN (Required when Role = 'admin')
ADMIN_ACCESS_PIN=9900

# Secret Key for Auth Session Tokens
JWT_SECRET=sahoo_sweets_super_secret_jwt_key_2026

# -----------------------------------------------------------------------------
# 1. REAL EMAIL OTP DELIVERY (Nodemailer SMTP or Resend API)
# -----------------------------------------------------------------------------
# Option A: Nodemailer SMTP (e.g. Gmail App Password)
# Note: For Gmail, create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sahoo Sweets" <no-reply@sahoosweets.com>

# Legacy / Alternative aliases
EMAIL_USER=
EMAIL_PASS=

# Option B: Resend API (Alternative to SMTP, get key from https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Sahoo Sweets <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# 2. REAL MOBILE SMS OTP DELIVERY (Twilio / Fast2SMS / MSG91)
# -----------------------------------------------------------------------------
# Provider Selector: 'twilio', 'fast2sms', or 'msg91'
SMS_PROVIDER=twilio

# Option A: Twilio Gateway (https://www.twilio.com)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Option B: Fast2SMS API Key (https://www.fast2sms.com)
FAST2SMS_API_KEY=
SMS_API_KEY=

# Option C: MSG91 Gateway (https://msg91.com)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
