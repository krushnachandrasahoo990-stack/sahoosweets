# =============================================================================
# SAHOO SWEETS - PRODUCTION & LOCAL BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# Frontend Allowed URL for CORS (Set this to your live Vercel URL on Render)
# Example: FRONTEND_URL=https://sahoosweets.vercel.app
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection URI (Leave empty for zero-crash in-memory fallback)
# Example: MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sahoosweets?retryWrites=true&w=majority
MONGODB_URI=

# Admin Master Access PIN (Required when Role = 'admin')
ADMIN_ACCESS_PIN=9900

# Secret Key for Auth Session Tokens
JWT_SECRET=sahoo_sweets_super_secret_jwt_key_2026

# -----------------------------------------------------------------------------
# 1. BRANDED EMAIL OTP DELIVERY ("Sahoo Sweets" via Nodemailer)
# -----------------------------------------------------------------------------
# Sender Name displayed in recipient's email client
OTP_SENDER_NAME="Sahoo Sweets"

# SMTP Server details (default: Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Sender email address
SMTP_USER=krushnachandrasahoo990@gmail.com

# 16-character Gmail App Password (NOT your regular Gmail password)
# How to generate:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create an App name (e.g. "Sahoo Sweets") and copy the 16-letter password here:
SMTP_PASS=

# Custom From Header (defaults to "Sahoo Sweets" <SMTP_USER>)
MAIL_FROM="Sahoo Sweets" <krushnachandrasahoo990@gmail.com>

# Resend API Alternative (Optional, https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Sahoo Sweets <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# 2. MOBILE SMS OTP DELIVERY (Twilio / Fast2SMS / MSG91)
# -----------------------------------------------------------------------------
# Provider Selector: 'twilio', 'fast2sms', or 'msg91'
SMS_PROVIDER=twilio

# Option A: Twilio Gateway (https://www.twilio.com)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Option B: Fast2SMS API Key (https://www.fast2sms.com)
FAST2SMS_API_KEY=
SMS_API_KEY=

# Option C: MSG91 Gateway (https://msg91.com)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
